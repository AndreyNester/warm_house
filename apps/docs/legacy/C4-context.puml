@startuml
!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

title C1 — Контекст системы «Тёплый дом»

Person(customer, "Клиент", "Житель дома. Управляет отоплением и мониторингом.")
Person(admin, "Администратор / Саппорт", "Обрабатывает заявки, управляет оборудованием.")
Person(tech, "Специалист", "Выезжает на дома и устанавливает оборудование.")

System_Boundary(td, "Экосистема «Тёплый дом»") {
    System(system, "Монолитное приложение «Тёплый дом»", "Управление отоплением, мониторинг температуры, заявки, склад, биллинг")
}

System_Ext(payment, "Платёжный шлюз", "Внешняя система обработчика платежей (СБП/карты)")
System_Ext(devices, "Датчики и приборы", "Физические IoT-устройства, передающие температуру")

' ' --- Relations ---
Rel(customer, system, "Управляет отоплением, просматривает температуру, подает заявки")
Rel(admin, system, "Управляет заявками, оборудованием, инвентарём, домами и правами")
Rel(tech, system, "Получает назначенные выезды и информацию об оборудовании")

Rel(system, devices, "Получает телеметрию, управляет устройствами")
Rel(system, payment, "Формирует запросы оплат и принимает статусы", "HTTPS")

@enduml
